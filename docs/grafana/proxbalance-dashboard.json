    {
      "id": 12,
      "type": "timeseries",
      "title": "Node score (lower is healthier)",
      "description": "Health penalty score. The dashboard's suitability is 100 minus this.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
