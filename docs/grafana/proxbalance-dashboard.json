      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (increase(proxbalance_migrations_total{dry_run=\"false\"}[1h]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Anchored CPU per node",
      "description": "CPU taken by guests that cannot move.",
      "datasource": {
        "type": "prometheus",
