[Unit]
Description=Proxmox Balance Manager API
After=network.target

[Service]
Type=notify
User=root
WorkingDirectory=/opt/proxmox-balance-manager
Environment="PATH=/opt/proxmox-balance-manager/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/proxmox-balance-manager/venv/bin/gunicorn \
    --workers 2 \
    --timeout 600 \
    --bind 0.0.0.0:5000 \
    --access-logfile - \
    --error-logfile - \
    --log-level info \
    app:app
Restart=always
RestartSec=3

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# The in-app updater and branch manager run post_update.sh from this service:
# it builds under /opt, copies the frontend to nginx's web root and installs
# unit files, so those paths must be writable too (otherwise the build lands
# in /opt but the browser keeps getting the old frontend).
ReadWritePaths=/opt/proxmox-balance-manager /var/www/html /etc/systemd/system

[Install]
WantedBy=multi-user.target
